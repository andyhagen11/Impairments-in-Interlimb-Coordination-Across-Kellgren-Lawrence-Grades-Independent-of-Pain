! Gait Event Detection: Enhanced version of Ghoussayni et al. (2004) using 3D resultant velocity method as outlined in Bonci et al. (2022) (M5 method).
! Heel strike: descending crossing of 3D heel velocity < 0.5 m/s
! Toe off: ascending crossing of 3D toe velocity > 0.5 m/s - this is different than what the original authors used, but better fit Baxter VA data.

! Segment name assumptions:
!   R_HEEL, L_HEEL  = heel landmarks (generated by Theia automatically)
!   RTO, LTO = toe segments (we will take most distal point as toe landmark/marker)

! Replace <<CMZ_NAME>>, <<CMZ_DIR>>, and <<SUBJ>> with the correct strings

! Open subject CMZ

File_Open
/FILE_NAME=<<CMZ_NAME>>
/FILE_PATH=<<CMZ_DIR>>
;

! Process only files that have been processed by Theia and are walk trials
! These are file tags "_Theia" and "Walk"

Select_Active_File
/FILE_NAME=ALL_FILES
/QUERY=_Theia & Walk
;

! Delete existing kinematic gait events if they exist

Event_Delete
/EVENT_NAME=KINEMATIC_VELOCITY_3D_RHS+KINEMATIC_VELOCITY_3D_LHS+KINEMATIC_VELOCITY_3D_RTO+KINEMATIC_VELOCITY_3D_LTO
;

! STEP 1: Compute heel and toe positions in LAB coordinates. Should already be in lab space for RHEEL and LHEEL but just use this to confirm when finding distal toes.

Compute_Model_Based_Data
/RESULT_NAME=RHEEL_LAB
/SUBJECT_TAG=NO_SUBJECT
/FUNCTION=TARGET_PATH
/SEGMENT=R_HEEL
/REFERENCE_SEGMENT=LAB
/RESOLUTION_COORDINATE_SYSTEM=LAB
;

Compute_Model_Based_Data
/RESULT_NAME=LHEEL_LAB
/SUBJECT_TAG=NO_SUBJECT
/FUNCTION=TARGET_PATH
/SEGMENT=L_HEEL
/REFERENCE_SEGMENT=LAB
/RESOLUTION_COORDINATE_SYSTEM=LAB
;

Compute_Model_Based_Data
/RESULT_NAME=RTOE_DIST_LAB
/SUBJECT_TAG=NO_SUBJECT
/FUNCTION=SEG_DISTAL_JOINT
/SEGMENT=RTO
/REFERENCE_SEGMENT=LAB
/RESOLUTION_COORDINATE_SYSTEM=LAB
;

Compute_Model_Based_Data
/RESULT_NAME=LTOE_DIST_LAB
/SUBJECT_TAG=NO_SUBJECT
/FUNCTION=SEG_DISTAL_JOINT
/SEGMENT=LTO
/REFERENCE_SEGMENT=LAB
/RESOLUTION_COORDINATE_SYSTEM=LAB
;

! Filter heel and toe signals

Lowpass_Filter
/SIGNAL_TYPES=LINK_MODEL_BASED
/SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=RHEEL_LAB+LHEEL_LAB+RTOE_DIST_LAB+LTOE_DIST_LAB
!/FILTER_CLASS=BUTTERWORTH
!/FREQUENCY_CUTOFF=6.0
!/NUM_BIDIRECTIONAL_PASSES=1
;

! STEP 2: Differentiate to get velocity (units: m/s)

First_Derivative
/SIGNAL_TYPES=LINK_MODEL_BASED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=RHEEL_LAB+LHEEL_LAB+RTOE_DIST_LAB+LTOE_DIST_LAB
! /RESULT_TYPES=
/RESULT_FOLDERS=VELOCITY
! /RESULT_NAME=
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=
;

! STEP 3: Define 3D resultant velocity using magnitude of x,y,z signals

Signal_Magnitude
/SIGNAL_TYPES=LINK_MODEL_BASED
/SIGNAL_FOLDER=VELOCITY
/SIGNAL_NAMES=RHEEL_LAB+LHEEL_LAB+RTOE_DIST_LAB+LTOE_DIST_LAB
/RESULT_FOLDERS=VELOCITY_3D
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

! STEP 4: Detect gait events via threshold crossing
!
! Heel strike = 3D heel velocity descending through +0.5 m/s
!   (foot decelerating to near-zero as it contacts ground)
! Toe off = 3D toe velocity ascending through +0.5 m/s
!   (foot accelerating forward as it leaves ground) 
!
! ENSURE_RANGE parameters reduce false positives by requiring
! a minimum number of frames consistently above/below threshold
! on both sides of the crossing. FRAME_WINDOW=20 provides
! ~200ms debounce at 100 Hz - adjust as needed see fit

! Right Heel Strikes

Event_Threshold
/RESULT_EVENT_NAME=KINEMATIC_VELOCITY_3D_RHS
/SUBJECT_TAG=ALL_SUBJECTS
/SIGNAL_TYPES=DERIVED
/SIGNAL_NAMES=RHEEL_LAB
/SIGNAL_FOLDER=VELOCITY_3D
!/SIGNAL_COMPONENTS=
/THRESHOLD=0.5
/ASCENDING=FALSE
/DESCENDING=TRUE
/FRAME_WINDOW=20
/ENSURE_RANGE_FRAMES_BEFORE_THRESHOLD_CROSSING=TRUE
/ENSURE_RANGE_FRAMES_AFTER_THRESHOLD_CROSSING=TRUE
/EVENT_INSTANCE=0
;

! Left Heel Strikes

Event_Threshold
/RESULT_EVENT_NAME=KINEMATIC_VELOCITY_3D_LHS
/SUBJECT_TAG=ALL_SUBJECTS
/SIGNAL_TYPES=DERIVED
/SIGNAL_NAMES=LHEEL_LAB
/SIGNAL_FOLDER=VELOCITY_3D
!/SIGNAL_COMPONENTS=
/THRESHOLD=0.5
/ASCENDING=FALSE
/DESCENDING=TRUE
/FRAME_WINDOW=20
/ENSURE_RANGE_FRAMES_BEFORE_THRESHOLD_CROSSING=TRUE
/ENSURE_RANGE_FRAMES_AFTER_THRESHOLD_CROSSING=TRUE
/EVENT_INSTANCE=0
;

! Right Toe Offs

Event_Threshold
/RESULT_EVENT_NAME=KINEMATIC_VELOCITY_3D_RTO
/SUBJECT_TAG=ALL_SUBJECTS
/SIGNAL_TYPES=DERIVED
/SIGNAL_NAMES=RTOE_DIST_LAB
/SIGNAL_FOLDER=VELOCITY_3D
!/SIGNAL_COMPONENTS=
/THRESHOLD=0.5
/ASCENDING=TRUE
/DESCENDING=FALSE
/FRAME_WINDOW=20
/ENSURE_RANGE_FRAMES_BEFORE_THRESHOLD_CROSSING=TRUE
/ENSURE_RANGE_FRAMES_AFTER_THRESHOLD_CROSSING=TRUE
/EVENT_INSTANCE=0
;

! Left Toe Off

Event_Threshold
/RESULT_EVENT_NAME=KINEMATIC_VELOCITY_3D_LTO
/SUBJECT_TAG=ALL_SUBJECTS
/SIGNAL_TYPES=DERIVED
/SIGNAL_NAMES=LTOE_DIST_LAB
/SIGNAL_FOLDER=VELOCITY_3D
!/SIGNAL_COMPONENTS=
/THRESHOLD=0.5
/ASCENDING=TRUE
/DESCENDING=FALSE
/FRAME_WINDOW=20
/ENSURE_RANGE_FRAMES_BEFORE_THRESHOLD_CROSSING=TRUE
/ENSURE_RANGE_FRAMES_AFTER_THRESHOLD_CROSSING=TRUE
/EVENT_INSTANCE=0
;

! Export events to MATLAB .m file

Export_Data_To_Matfile
/SIGNAL_TYPES=EVENT_LABEL+EVENT_LABEL+EVENT_LABEL+EVENT_LABEL
/SIGNAL_FOLDER=ORIGINAL+ORIGINAL+ORIGINAL+ORIGINAL
/SIGNAL_NAMES=KINEMATIC_VELOCITY_3D_LHS+KINEMATIC_VELOCITY_3D_LTO+KINEMATIC_VELOCITY_3D_RHS+KINEMATIC_VELOCITY_3D_RTO
/FILE_NAME=<<SUBJ>>_GaitEvents.mat
/FOLDER=<<CMZ_DIR>>
/CREATE_FOLDER_PATH=FALSE
/MATLAB_NAMES=LHS+LTO+RHS+RTO
! /PARAMETER_NAMES=
! /PARAMETER_GROUPS=
! /OUTPUT_PARAMETER_NAMES=
/USE_NAN_FOR_DATANOTFOUND=TRUE
;

File_Save
;

Exit_Workspace
;
